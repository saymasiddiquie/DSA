class Solution {
public:
    void sortColors(vector<int>& nums) {
        unordered_map<int,int> mp;
        for(int i=0;i<nums.size();i++){
            mp[nums[i]]++;
        }
        int i = 0;
        while(mp[0]--) {
            nums[i++] = 0;
        }

        while(mp[1]--) {
            nums[i++] = 1;
        }

        while(mp[2]--) {
            nums[i++] = 2;
        }
    }
};

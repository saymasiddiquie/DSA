#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int peakElement(vector<int>& n) {
        int left = 0;
        int right = n.size() - 1;

        while(left < right) {
            int mid = left + (right - left) / 2;

            if(n[mid] < n[mid + 1]) {
                left = mid + 1;
            }
            else {
                right = mid;
            }
        }

        return left;
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int a;
    cin >> a;

    vector<int> n(a);

    for(int i = 0; i < a; i++) {
        cin >> n[i];
    }

    Solution s;

    cout << s.peakElement(n);

    return 0;
}

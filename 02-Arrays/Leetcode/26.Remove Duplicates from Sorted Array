class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        unordered_map<int,int> freq;
        for(int i: nums){
            freq[i]++;
        }
        vector<int> ans;
        for(auto i: freq){
            ans.push_back(i.first);
            
        }
        sort(ans.begin(), ans.end());

        for(int i = 0; i < ans.size(); i++) {
            nums[i] = ans[i];
        }
        return ans.size();
        
    }
};

class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        set<int> seen;
        int left=0;
        for(int right=0;right<nums.size();right++){
            if(seen.count(nums[right])){
                return true;
            }
            seen.insert(nums[right]);

        }
        return false;
    }
};

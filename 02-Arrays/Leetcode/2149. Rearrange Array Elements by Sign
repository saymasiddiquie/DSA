class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        vector<int> positive;
        vector<int> negative;
        for(int i : nums){
            if(i>0){
                positive.push_back(i);
            }
            else{
                negative.push_back(i);
            }
        }
        vector<int> ans;
        for(int i=0;i<positive.size();i++){
            ans.push_back(positive[i]);
            ans.push_back(negative[i]);
        
        }
        return ans;

    }
};

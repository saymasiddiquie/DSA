class Solution {
public:
    void sortColors(vector<int>& nums) {
        int n=nums.size();
        int countZeros=0;
        int countOnes =0;
        int countTwos=0;
        for(int i=0;i<n;i++){
            if(nums[i]==0){
                countZeros++;
            }
            else if(nums[i]==1){
                countOnes++;
            }
            else{
                countTwos++;
            }
        }
        int i=0;
        while(countZeros>0){
            nums[i]=0;
            i++;
            countZeros--;
        }
        while(countOnes>0){
            nums[i]=1;
            i++;
            countOnes--;
        }
        while(countTwos>0){
            nums[i]=2;
            i++;
            countTwos--;
        }

    }
};

class Solution {
public:
    int majorityElement(vector<int>& nums) {
        unordered_map<int,int> mp;
        for(int x: nums){
            mp[x]++;
        }
        int greater=(nums.size())/2;
        for(int i=0;i<nums.size();i++){
            if(mp[nums[i]]>greater){
                return nums[i];
            }
        }
        return -1;
    }
};

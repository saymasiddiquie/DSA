#include <bits/stdc++.h>
using namespace std;
class solution{
public:
  int finding_smallest_number(vector<int> & nums){
    int n=nums.size();
    int left=0;
    int right=n-1;
    while(left<=right){
      int mid=left+(right-left) / 2;
      if(nums[mid]==mid){
        left=mid+1;
      }
      else{
        right=mid-1;
      }
    }
    return left;
  }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    cin>>n;
    vector<int> nums(n);
    for(int i=0;i<n;i++){
      cin>>nums[i];
    }
    solution obj;
    cout << obj.finding_smallest_number(nums);
